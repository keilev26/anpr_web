# URL de la API de F2. En dev, vite.config.ts la usa como proxy de /api
VITE_API_URL=http://localhost:8000

# false = contra la API real de F2 (necesita que corra en VITE_API_URL).
# true  = contra los mocks de MSW, sin backend. Útil para trabajar en la UI
#         aislado, o si F2 no está levantado.
VITE_USE_MOCKS=false
