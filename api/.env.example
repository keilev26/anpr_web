# SQLite por defecto: la API arranca sin instalar nada más.
# MySQL en producción:  mysql+aiomysql://user:pass@host:3306/anpr
DATABASE_URL=sqlite+aiosqlite:///./anpr.db

# Firma de los JWT. En producción va en Secrets Manager, NUNCA en el repo.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esto-en-produccion-o-la-api-se-niega-a-arrancar

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Orígenes del frontend (F1), separados por coma.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Clave que presenta la Raspberry Pi en POST /v1/detections.
DEVICE_API_KEY=clave-del-dispositivo-de-la-puerta-2

# false en producción: pone la cookie de refresh como Secure (solo HTTPS).
DEV_MODE=true
